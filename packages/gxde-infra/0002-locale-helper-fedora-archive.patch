 func IsLocaleValid(locale string) bool {
+	// Debian exposes the complete locale catalogue through /etc/locale.gen.
+	// Keep that behavior whenever the file exists.
 	finfo, err := NewLocaleFileInfo(defaultLocaleGenFile)
+	if err == nil {
+		return finfo.IsLocaleValid(locale)
+	}
+
+	// Fedora stores precompiled locales in the glibc archive and does not ship
+	// /etc/locale.gen or locale-gen. Query libc's public locale interface and
+	// accept spelling differences such as ja_JP.UTF-8 versus ja_JP.utf8.
+	output, err := exec.Command("locale", "-a").Output()
 	if err != nil {
 		return false
 	}
+	wanted := normalizeLocaleName(locale)
+	for _, available := range strings.Fields(string(output)) {
+		if normalizeLocaleName(available) == wanted {
+			return true
+		}
+	}
+	return false
+}
 
-	return finfo.IsLocaleValid(locale)
+func normalizeLocaleName(locale string) string {
+	replacer := strings.NewReplacer(
+		".", "",
+		"-", "",
+	)
+	return strings.ToLower(replacer.Replace(strings.TrimSpace(locale)))
 }
 
